# Segredos das Edge Functions.
# Local:     copie para supabase/functions/.env  (usado por `pnpm functions:serve`)
# Produção:  supabase secrets set --env-file supabase/functions/.env.production
# Os dois arquivos reais estão no .gitignore.

ASAAS_AMBIENTE=sandbox            # sandbox | producao
# Entre aspas simples: a chave começa com "$" e, sem aspas, é expandida como variável (vira vazio → 401).
ASAAS_API_KEY=''                  # sandbox: '$aact_hmlg_...'  produção: '$aact_prod_...'
ASAAS_WEBHOOK_TOKEN=              # mesmo token configurado no webhook do painel Asaas

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

EXPO_ACCESS_TOKEN=                # opcional: reforça a segurança do envio de push

CRON_SECRET=                      # segredo do pg_cron (mesmo valor no Vault: cron_secret)
CODIGO_PEPPER=                    # texto aleatório longo, usado no hash dos códigos de acesso
RESEND_API_KEY=                   # opcional: envio do código por e-mail
EMAIL_REMETENTE=                  # ex.: Planejar Assessoria <app@dominio.com.br>
